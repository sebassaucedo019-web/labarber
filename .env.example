# Este .env es tu entorno de DESARROLLO — usá el número de prueba de Meta acá, nunca el
# de producción. El número de producción va en credenciales separadas al momento del
# deploy, no en tu laptop. Ver docs/07-entornos-test-vs-produccion.md.

# --- Meta WhatsApp Cloud API ---
# Sacás estos valores de developers.facebook.com/apps → tu app → WhatsApp → API Setup
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Token PERMANENTE de System User. El token de 24h del dashboard no sirve para producción.
# Ver docs/02-configuracion-meta.md

# --- Modelo de IA ---
# Elegí un modelo vigente en platform.openai.com/docs/models — no lo dejamos fijo
# en el template porque los modelos disponibles cambian con frecuencia.
OPENAI_MODEL=gpt-6-luna

# --- Redis (hilo activo, dedupe, debounce) ---
REDIS_URL=redis://localhost:6379/0

# --- Postgres (historial persistente, auditoría) ---
DATABASE_URL=postgresql+psycopg://agente:agente@localhost:5432/agente_whatsapp

# --- Comportamiento del bot ---
# Segundos de espera antes de procesar mensajes seguidos del mismo usuario
DEBOUNCE_SECONDS=2.5
# Mensajes por minuto permitidos por usuario antes de frenar
RATE_LIMIT_PER_MINUTE=20

# --- Escalado a humano (obligatorio antes de producción, ver docs/08-escalado-a-humano.md) ---
# A dónde avisar cuando el bot no puede resolver algo o el usuario pide hablar con
# alguien. Sin esto, escalar_humano no le avisa a nadie — solo queda en el log.
#   Slack:   api.slack.com/apps > tu app > Incoming Webhooks > Add New Webhook > URL
#            (pegala tal cual, el código ya arma el mensaje en su formato)
#   Discord: canal > Configuración > Integraciones > Webhooks > Nuevo Webhook > URL
#            (mismo caso, va directo)
#   Email:   no hay "webhook a email" directo — usá un Catch Hook de n8n/Zapier que
#            reciba esto y mande el mail.
ESCALATION_WEBHOOK_URL=

# --- Opcional: transcripción de audio alternativa (ver examples/audio_transcripcion) ---
# Por default el ejemplo de audio reusa OPENAI_API_KEY, no necesita esto. Solo hace
# falta si cambiás a Groq Whisper (más barato a volumen alto) — sacala en
# console.groq.com/keys
GROQ_API_KEY=

# --- Opcional: integración CRM (ver examples/crm_webhook) ---
CRM_WEBHOOK_URL=

