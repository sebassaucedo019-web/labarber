# Copia este archivo como .env y completa los valores localmente.
# Nunca pongas credenciales reales en .env.example ni lo subas con secretos.

META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=cambia-este-token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

OPENAI_API_KEY=
# Nombre real del modelo en platform.openai.com/docs/models. No lo dejes vacío.
OPENAI_MODEL=gpt-6-luna

REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite:///./barber_demo.db

DEBOUNCE_SECONDS=2.5
RATE_LIMIT_PER_MINUTE=20
INBOUND_LIMIT_PER_MINUTE=20
MAX_PENDING_MESSAGES=40
GLOBAL_AI_TURNS_PER_MINUTE=60
# No inventar políticas: 0 conserva la anticipación mínima anterior.
BOOKING_MIN_NOTICE_MINUTES=0
# BOOKING_MAX_ADVANCE_DAYS=60
# Duraciones por servicio, múltiplos de 30 minutos. {} conserva 30 min actuales.
SERVICE_DURATIONS={}
# Solo durante la migración con respaldo y web/worker anteriores detenidos.
# Ver docs/12-correcciones-auditoria.md antes de desplegar esta versión.
CALENDAR_UTC_MIGRATION_ENABLED=false
ESCALATION_WEBHOOK_URL=
GROQ_API_KEY=
CRM_WEBHOOK_URL=
OWNER_WA_ID=
BARBER_OBED_WA_ID=
BARBER_JESUS_WA_ID=
BARBER_YADIER_WA_ID=

# Recordatorios y próximo turno: mantener false hasta autorizar
# y probar las plantillas en Meta.
# No desactiva las confirmaciones de reservas ni el outbox existente.
AUTOMATIC_NOTICES_ENABLED=false
BUSINESS_NAME=Red Level Barber
REMINDER_TEMPLATE_NAME=
TURN_TEMPLATE_NAME=
# Plantilla aprobada con un parámetro de texto para avisos de citas fuera de 24 h.
APPOINTMENT_TEMPLATE_NAME=
SUPPORT_TEMPLATE_NAME=
NOTIFICATION_TEMPLATE_LANGUAGE=es_MX
# Opcional: lista JSON que sustituye el directorio Obed/Jesus/Yadier.
# hours usa días 0=lunes a 6=domingo; minutos desde medianoche, intervalos de 30 min.
# BARBERS=[{"name":"Obed","phone":"","hours":{"0":[[540,1200]],"1":[[540,1200]]}}]
