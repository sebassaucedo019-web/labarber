# Copia este archivo como .env y completa los valores localmente.
# Nunca pongas credenciales reales en .env.example ni lo subas con secretos.

META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=cambia-este-token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

OPENAI_API_KEY=
# Nombre real del modelo en platform.openai.com/docs/models. No lo dejes vacío.
OPENAI_MODEL=gpt-6-luna

REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite:///./barber_demo.db

DEBOUNCE_SECONDS=2.5
RATE_LIMIT_PER_MINUTE=20
ESCALATION_WEBHOOK_URL=
GROQ_API_KEY=
CRM_WEBHOOK_URL=
OWNER_WA_ID=
BARBER_OBED_WA_ID=
BARBER_JESUS_WA_ID=
BARBER_YADIER_WA_ID=
